NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Staging/prod DB URLs — use SSH tunnel for direct access:
# make studio-staging  →  then use localhost:54323 for Studio
# For migrations: gcloud compute ssh supabase-staging -- -L 15432:localhost:5432 -N
# Then: pnpm supabase db push --db-url "postgresql://postgres:<pass>@localhost:15432/postgres"
DATABASE_URL_STAGING=postgresql://postgres:<staging-password>@localhost:15432/postgres
DATABASE_URL_PROD=postgresql://postgres:<prod-password>@localhost:15433/postgres
